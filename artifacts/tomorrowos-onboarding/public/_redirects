# Netlify SPA routing with correct HTTP status codes.
#
# The build emits a prerendered index.html for every known route (/, /about,
# /guides/*, etc.) via prerenderPlugin in vite.config.ts. Netlify serves
# static files before applying redirect rules, so those prerendered files are
# picked up automatically without explicit entries here.
#
# Only routes that intentionally have no prerendered file are listed:
# - /quickstart   — client-side redirect to /
# - /github       — PlaceholderPage
# - /community    — PlaceholderPage
# - /license      — PlaceholderPage
#
# The nine /learn routes are feature-gated behind VITE_ENABLE_LEARN. When
# enabled they are prerendered like other known routes (static files served
# directly); when disabled (production default) no /learn HTML exists and the
# catch-all 404 rule below serves the SPA shell, which renders NotFound.
#
# Unknown paths fall through to the catch-all 404 rule.
# Keep SPA-only entries below in sync with src/App.tsx whenever placeholder
# routes are promoted or removed.

/quickstart    /index.html  200
/github        /index.html  200
/community     /index.html  200
/license       /index.html  200

# Unknown routes: SPA shell with HTTP 404 (client renders noindex 404 page).
/*             /index.html  404
